<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Produk</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning py-3">
                    <h5 class="mb-0 fw-bold">EDIT DATA PRODUK</h5>
                </div>
                <div class="card-body p-4">
                    <form action="/produk/update/<%= id %>" method="POST" enctype="multipart/form-data">
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nama Produk</label>
                            <input type="text" name="nama_produk" value="<%= nama_produk %>" class="form-control" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Harga (Rp)</label>
                            <input type="number" name="harga" value="<%= harga %>" class="form-control" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Kategori</label>
                            <select name="id_kategori" class="form-select" required>
                                <% for(var i = 0; i < data_kategori.length; i++) { %>
                                    <option value="<%= data_kategori[i].id_kategori %>" 
                                        <%= data_kategori[i].id_kategori == id_kategori ? 'selected' : '' %>>
                                        <%= data_kategori[i].nama_kategori %>
                                    </option>
                                <% } %>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Gambar Produk</label>
                            <div class="mb-2">
                                <small class="text-muted d-block">Gambar saat ini:</small>
                                <img src="/images/<%= gambar_produk %>" width="100" class="img-thumbnail shadow-sm">
                            </div>
                            <input type="file" name="gambar_produk" class="form-control">
                            <small class="text-danger">*Kosongkan jika tidak ingin mengubah gambar</small>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-warning fw-bold">Update Produk</button>
                            <a href="/produk" class="btn btn-light border">Batal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
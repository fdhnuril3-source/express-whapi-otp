<%- include ('../partials/_head') %>
    <a href="/kategori/create" class="btn btn-sm btn-primary">Tambah data</a>
<%- include ('../partials/_message') %>
    <% if (messages.error) { %>
    <div class="alert alert-danger">
        <%- messages.error %>
    </div>
    <%  } %>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nama</th>
                <th>Nomer</th>
                <th>Aksi</th>
            </tr>
        </thead>
        <tbody>
            <% for(var i = 0; i < data.length; i++) {%>

            <tr>
                <th scope="row"><%= (i+1) %></th>
                <td><%= data[i].nama_kategori %></td>
                <td><a href="/kategori/edit/<%= data[i].id_kategori %>" class="btn btn-sm btn-warning">Edit</a>
                <a href="/kategori/delete/<%= data[i].id_kategori %>" class="btn btn-sm btn-danger">delete</a>
            </td>
            </tr>

            <% } %>
        </tbody>
    </table>

 <%- include ('../partials/_foot') %>  